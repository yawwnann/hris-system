{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://202.10.41.21/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "http://202.10.41.21/storage/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
